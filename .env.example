# Supabase Postgres (recommended):
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<supabase_db_password>
#
# Local Postgres fallback:
DB_URL=jdbc:postgresql://localhost:5432/employee_management
DB_USERNAME=postgres
DB_PASSWORD=postgres

PORT=8080
ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:3001
ATTENDANCE_ZONE_ID=Asia/Kathmandu
ATTENDANCE_REQUIRED_MINUTES=420
ATTENDANCE_GRACE_MINUTES=360
JWT_SECRET=replace_this_with_minimum_32_characters_secret
JWT_EXPIRATION_MS=86400000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SHOW_SQL=false

# Gmail SMTP (optional - verification links and password OTPs are logged when MAIL_ENABLED=false)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the same Gmail address for MAIL_USERNAME and MAIL_FROM
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_FROM=your.email@gmail.com
FRONTEND_BASE_URL=http://localhost:3000
