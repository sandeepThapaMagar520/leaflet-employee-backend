# Supabase Postgres (recommended):
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=<supabase_db_password>
#
# Local Postgres fallback:
APP_ENVIRONMENT=development
DB_URL=jdbc:postgresql://localhost:5432/employee_management
DB_USERNAME=postgres
DB_PASSWORD=postgres

PORT=8080
ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:3001
ATTENDANCE_ZONE_ID=Asia/Kathmandu
ATTENDANCE_REQUIRED_MINUTES=420
ATTENDANCE_GRACE_MINUTES=360
JWT_SECRET=local_only_explicit_development_jwt_secret_123456789
JWT_EXPIRATION_MS=900000
JWT_ISSUER=leaflet-ems
JWT_AUDIENCE=leaflet-ems-web
JWT_KEY_ID=local-development-key

OTP_VALIDITY_SECONDS=600
RESET_TOKEN_VALIDITY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_ACCOUNT_ISSUANCE_LIMIT_PER_HOUR=5
OTP_IP_ISSUANCE_LIMIT_PER_HOUR=20
OTP_ACCOUNT_ISSUANCE_LIMIT_PER_DAY=10
OTP_ACCOUNT_VERIFICATION_LIMIT_PER_15_MINUTES=20
OTP_IP_VERIFICATION_LIMIT_PER_15_MINUTES=60

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MEDIA_USER_HOURLY_LIMIT=30
MEDIA_IP_HOURLY_LIMIT=80
MEDIA_PENDING_LIMIT=5
MEDIA_STORED_BYTES_PER_PURPOSE=104857600
MEDIA_PRIVATE_DOWNLOAD_TTL_SECONDS=120
MEDIA_CLEANUP_CRON="0 17 * * * *"
# Required as true in production. Attachments remain quarantined when unavailable.
MEDIA_SCANNER_ENABLED=false
MEDIA_SCANNER_HOST=localhost
MEDIA_SCANNER_PORT=3310
MEDIA_SCANNER_CONNECT_TIMEOUT_MS=2000
MEDIA_SCANNER_READ_TIMEOUT_MS=15000
SHOW_SQL=false

# Google Apps Script mail webhook
MAIL_ENABLED=false
MAIL_PROVIDER=GOOGLE_APPS_SCRIPT
GOOGLE_MAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_MAIL_WEBHOOK_SECRET=replace_with_a_long_random_secret
MAIL_FROM_NAME=Leaflet EMS
FRONTEND_BASE_URL=http://localhost:3000

# One-time emergency administrator bootstrap. Leave disabled except during an
# explicitly approved recovery. Remove all four variables immediately after use.
EMERGENCY_ADMIN_BOOTSTRAP_ENABLED=false
EMERGENCY_ADMIN_BOOTSTRAP_EMAIL=
EMERGENCY_ADMIN_BOOTSTRAP_FULL_NAME=Emergency Administrator
EMERGENCY_ADMIN_BOOTSTRAP_PASSWORD=
LEAVE_EXCLUDE_WEEKENDS=false
ATTENDANCE_MAX_SESSION_MINUTES=1440
ATTENDANCE_CORRECTION_DEADLINE_DAYS=30
